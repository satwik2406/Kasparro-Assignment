# ==============================================================================
# AI Resume Screening & Ranking System - Configuration
# ==============================================================================

# GitHub Personal Access Token (Optional)
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr for enrichment.
# If omitted, public API unauthenticated requests are used, with graceful fallback.
GITHUB_TOKEN=

# LLM Provider Configuration (Optional)
# If no API key is provided, the system seamlessly falls back to the deterministic,
# explainable rule-based scoring engine with zero errors.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-1.5-flash

# Concurrency & Performance Settings
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=15
GITHUB_CACHE_TTL_SECONDS=3600

# Scoring Weights (Must sum to 100)
WEIGHT_AI_PROJECT_DEPTH=40
WEIGHT_PYTHON_BACKEND=30
WEIGHT_CLOUD_FULLSTACK=15
WEIGHT_GITHUB_ACTIVITY=10
WEIGHT_ENGINEERING_DEPTH=5
